# All optional. The app runs with none of these set.

# Raises the GitHub API limit for the footer's star/fork counts from 60 to 5000
# requests per hour. Only needed if you deploy somewhere with real traffic;
# a read-only token with no scopes is enough.
GITHUB_TOKEN=

# Note: there is no ANTHROPIC_API_KEY or OPENAI_API_KEY here on purpose.
# Keys are supplied per request by the person using the app and are never
# stored server-side. See SECURITY.md.
